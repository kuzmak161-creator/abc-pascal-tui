#!/usr/bin/env python3
"""PascalTUI — терминальная IDE для PascalABC.NET. """
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

MIN_TEXTUAL = (0, 86)


def _check_textual() -> None:
    try:
        import textual
    except ImportError:
        sys.exit("Textual не установлен / Textual is not installed:\n  pip install textual")
    try:
        version = tuple(int(x) for x in textual.__version__.split(".")[:2])
    except (ValueError, AttributeError):
        return
    if version < MIN_TEXTUAL:
        print(
            f"[!] Textual {textual.__version__} староват, нужен >= {'.'.join(map(str, MIN_TEXTUAL))} "
            "(темы, подсказки). Обновите: pip install -U textual",
            file=sys.stderr,
        )


def main() -> None:
    _check_textual()
    from pascaltui.app import PascalTUI

    PascalTUI().run()


if __name__ == "__main__":
    main()
